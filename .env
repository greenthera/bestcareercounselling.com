# Single source of truth for the site's live URL. Read by src/lib/seo.ts (canonical
# links, structured data, per-page SEO), by index.html (%VITE_SITE_URL% placeholders,
# via Vite's built-in HTML env replacement), and by scripts/generate-seo-files.mjs
# (robots.txt and sitemap.xml, run automatically before every build).
#
# If the site ever moves to a different URL, this is the ONLY place that needs to
# change — everything above regenerates from it on the next build/deploy.
VITE_SITE_URL=https://greenthera.shivantra.com/bestcareercounselling.com
